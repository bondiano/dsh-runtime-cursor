{
  "name": "@local/dsh-runtime-cursor",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "!dist/test/",
    "index.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.2-rc.3"
  },
  "peerDependencies": {
    "@cursor/sdk": "1.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondiano/dsh-runtime-cursor.git"
  },
  "homepage": "https://github.com/bondiano/dsh-runtime-cursor#readme",
  "bugs": {
    "url": "https://github.com/bondiano/dsh-runtime-cursor/issues"
  },
  "dependencies": {
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "7.0.2"
  }
}
